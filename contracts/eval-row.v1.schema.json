{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/lorenzh/spatz/main/contracts/eval-row.v1.schema.json",
	"title": "spatz-eval-row/1",
	"description": "One bench run as spatz imports it. JSON Lines, one object per run. Unknown fields are ignored; a breaking change bumps the version. See docs/bench.md.",
	"type": "object",
	"properties": {
		"schema": { "const": "spatz-eval-row/1" },
		"run_id": {
			"type": "string",
			"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
		},
		"bench_version": { "type": "string", "minLength": 1 },
		"task_id": { "type": "string", "minLength": 1 },
		"task_version": { "type": "integer", "minimum": 1 },
		"task_type": {
			"enum": [
				"code.bugfix",
				"code.feature",
				"code.refactor",
				"code.test",
				"code.explain",
				"investigation",
				"review",
				"spec",
				"planning",
				"ops",
				"design.ui",
				"design.visual",
				"design.3d",
				"writing",
				"research",
				"data"
			]
		},
		"difficulty": { "enum": ["easy", "medium", "hard"] },
		"criticality": {
			"enum": ["none", "business_logic", "security", "data_integrity"],
			"default": "none"
		},
		"harness": { "type": "string", "minLength": 1 },
		"agent_version": { "type": "string", "minLength": 1 },
		"model": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]*/\\S+$",
			"description": "Canonical OpenRouter id, after toCanonicalId."
		},
		"effort": {
			"enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra"]
		},
		"answered_model": { "type": ["string", "null"], "minLength": 1 },
		"model_version": { "type": ["string", "null"], "minLength": 1 },
		"attempt": { "type": "integer", "minimum": 1 },
		"result": { "enum": ["pass", "partial", "fail"] },
		"check": { "enum": ["tests", "golden", "rubric", "human"] },
		"judge": {
			"type": ["string", "null"],
			"minLength": 1,
			"description": "Rubric judge id; null for tests and golden."
		},
		"duration_s": { "type": "number", "minimum": 0 },
		"tokens": {
			"type": "object",
			"description": "Null means not reported, never 0. input and output are null only when every counter, cost_usd and estimated_cost_usd are null.",
			"properties": {
				"input": { "type": ["integer", "null"], "minimum": 0 },
				"output": { "type": ["integer", "null"], "minimum": 0 },
				"cache_read": { "type": ["integer", "null"], "minimum": 0 },
				"cache_write": { "type": ["integer", "null"], "minimum": 0 },
				"reasoning": { "type": ["integer", "null"], "minimum": 0 }
			},
			"required": ["input", "output", "cache_read", "cache_write", "reasoning"]
		},
		"cost_usd": { "type": ["number", "null"], "minimum": 0 },
		"estimated_cost_usd": {
			"type": ["number", "null"],
			"minimum": 0,
			"default": null,
			"description": "Each token counter times the model's official list price per token (reasoning is part of output). Optional; null when not estimated."
		},
		"started_at": {
			"type": "string",
			"pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?Z$",
			"description": "ISO 8601 UTC on a real calendar day."
		},
		"contributor": { "type": "string", "minLength": 1 },
		"verified": { "type": "boolean" }
	},
	"required": [
		"schema",
		"run_id",
		"bench_version",
		"task_id",
		"task_version",
		"task_type",
		"difficulty",
		"harness",
		"agent_version",
		"model",
		"effort",
		"answered_model",
		"model_version",
		"attempt",
		"result",
		"check",
		"judge",
		"duration_s",
		"tokens",
		"cost_usd",
		"started_at",
		"contributor",
		"verified"
	],
	"allOf": [
		{
			"if": { "properties": { "check": { "enum": ["tests", "golden"] } } },
			"then": { "properties": { "judge": { "const": null } } }
		},
		{
			"if": {
				"properties": {
					"tokens": { "properties": { "input": { "type": "null" } } }
				}
			},
			"then": {
				"properties": {
					"tokens": {
						"properties": {
							"output": { "type": "null" },
							"cache_read": { "type": "null" },
							"cache_write": { "type": "null" },
							"reasoning": { "type": "null" }
						}
					},
					"cost_usd": { "type": "null" },
					"estimated_cost_usd": { "type": "null" }
				}
			},
			"else": {
				"properties": {
					"tokens": { "properties": { "output": { "type": "integer" } } }
				}
			}
		}
	],
	"additionalProperties": true
}
