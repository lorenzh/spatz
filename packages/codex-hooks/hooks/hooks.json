{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "sh \"${PLUGIN_ROOT}/bin/spatz\" hook PostToolUse --agent codex",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "sh \"${PLUGIN_ROOT}/bin/spatz\" hook Stop --agent codex",
						"timeout": 10
					}
				]
			}
		]
	}
}
