#!/bin/sh
# Generated by scripts/plugin-assets.ts; version follows the plugin manifest.
# spatz hook always exits 0, so a failed hook call failed here. Hooks hide stderr:
# one line per failure in ~/.spatz/launcher-failures shows it in spatz stats.
failed() {
    [ "$1" = hook ] && mkdir -p "$HOME/.spatz" 2>/dev/null &&
        printf '%s\n' "$2" >>"$HOME/.spatz/launcher-failures" 2>/dev/null
}
run() {
    [ "$cmd" = hook ] || exec "$@"
    "$@" && exit 0
    status=$?
    failed hook "$event"
    exit "$status"
}
cmd=$1 event=$2
if [ -z "$SPATZ_LAUNCHER" ] && command -v spatz >/dev/null 2>&1; then
    export SPATZ_LAUNCHER=1
    run spatz "$@"
elif command -v bunx >/dev/null 2>&1; then
    run bunx @spatz/cli@0.1.6 "$@"
elif command -v npx >/dev/null 2>&1; then
    run npx -y @spatz/cli@0.1.6 "$@"
fi
echo "install the spatz CLI: npm i -g @spatz/cli" >&2
failed "$cmd" "$event"
exit 1
